# Gateway FastAPI address (used by the Streamlit UI to call this API)
GATEWAY_URI=localhost
GATEWAY_PORT=8001

# Optional: set to DEBUG for verbose logging
LOG_LEVEL=INFO

# ── Remote PACS (optional — enables PACS comparison features) ─────────────────
# The only functionality left in this service. The PACS must be reachable
# from this host's network.
# PACS_AE_TITLE=PACS
# PACS_HOST=192.168.x.x
# PACS_PORT=104
# GATEWAY_AE_TITLE=HERMES_GW   # AE title presented when initiating DICOM connections
# DGATE_EXE_PATH=C:\path\to\dgate64.exe   # Conquest exe for UID anonymisation; omit to send real UIDs (passthrough/dev mode)

# Note: HERMES_URL and ANON_DB_* used to live here (the old proxy+anonymisation
# gateway). Anonymisation now lives in the backend itself (see backend/.env),
# and the proxy that replaces this service's old forwarding role is in proxy/
# with its own HERMES_URL. The ui/ Streamlit pages in this directory are stale
# until the Django frontend work (which will likely absorb PACS querying too)
# resumes.
