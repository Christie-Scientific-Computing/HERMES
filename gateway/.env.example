# URL of the Hermes backend on the secure internal network (used by FastAPI gateway)
HERMES_URL=http://192.168.x.x:8000

# Gateway FastAPI address (used by the Streamlit frontend to call the gateway API)
GATEWAY_URI=localhost
GATEWAY_PORT=8001

# Optional: set to DEBUG for verbose logging
LOG_LEVEL=INFO

# ── PACS comparison (set these in the Hermes backend .env, not here) ──────────
# PACS_AE_TITLE=PACS
# PACS_HOST=192.168.x.x
# PACS_PORT=104
