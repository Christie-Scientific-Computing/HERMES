# HERMES backend — copy to .env and fill in.

# ── Orthanc (central DICOM server) ────────────────────────────────────────────
ORTHANC_URL=https://192.168.x.x:8042
ORTHANC_USER=orthanc
ORTHANC_PASS=

# ── Streamlit → backend location (used by Home.py / pages/) ──────────────────
BACKEND_URI=localhost
BACKEND_PORT=8000

# ── HermesDB (job/event tracking; fully HERMES-owned, freely migrated) ───────
# Postgres DSN. Required — the backend exits immediately if unset.
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes

# ── Pinnacle ───────────────────────────────────────────────────────────────────
# Path to Pinnacle's own read-only SQLite export cache (not HERMES-owned).
PINN_DB=./db/pinn_db.sqlite
# Postgres schema (inside DATABASE_URL's database) where PinnacleExport records
# its own status/errors/plans tables. HERMES only ever SELECTs from it and has
# no migrations for it -- PinnacleExport owns it. Unset -> "pinnacle_export";
# if that schema doesn't exist, the patient page just reports plans as
# unavailable rather than erroring.
# PINNACLE_SCHEMA=pinnacle_export
# Destination the Pinnacle export submodule pushes to. Defaults shown are
# the historical hardcoded values; override for your environment.
# PINNACLE_PUSH_HOST=192.168.117.5
# PINNACLE_PUSH_PORT=32806
# PINNACLE_PUSH_AE_TITLE=old_mosaiq_router

# ── DICOM Q/R sources ──────────────────────────────────────────────────────────
PULL_MODALITY_AET_ONE=
PULL_MODALITY_AET_TWO=

# ── TLS ────────────────────────────────────────────────────────────────────────
PATH_TO_CERT=
PATH_TO_KEY=

# ── Anon-mapping DB (optional) ────────────────────────────────────────────────
# An existing, externally-owned, read-only Postgres database mapping
# anonymised patient IDs to real ones. HERMES never writes to it. Unset →
# passthrough (no anonymisation), appropriate for internal-only deployments.
# Set these when this backend is reachable from outside the secured network
# (i.e. fronted by proxy/). See backend/src/identity/anon.py for the queries.
# ANON_DB_HOST=
# ANON_DB_PORT=5432
# ANON_DB_NAME=
# ANON_DB_USER=
# ANON_DB_PASS=

# ProKnow credentials live in credentials.json (git-ignored), not here.
