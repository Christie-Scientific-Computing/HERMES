# URL of the HERMES backend on the secure internal network
HERMES_URL=http://192.168.x.x:8000

# Optional: set to DEBUG for verbose logging
LOG_LEVEL=INFO

# That's it. Anonymisation used to live here (as part of the old `gateway`
# service) but now lives in the backend itself -- see
# backend/src/identity/anon.py and its ANON_DB_* env vars in the backend's
# own .env. This proxy has no database of its own and no business logic;
# it only forwards requests to HERMES_URL.
#
# PACS comparison (gateway/pacs_client.py, PACS_*/DGATE_EXE_PATH env vars)
# is parked, not part of this proxy or the backend -- it's frontend-only
# functionality, unwired until the Django frontend work resumes.
